NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Solo para el servidor (Settings -> API -> service_role en Supabase). NUNCA
# le pongas el prefijo NEXT_PUBLIC_ ni la subas al repo: salta RLS por
# completo. La usan /api/admin/* para eliminar usuarios de auth y para
# generar el link de "ver como este usuario" en /admin.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
